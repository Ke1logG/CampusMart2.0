<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.CampusMart.web.mapper.GoodsCollectionMapper">

    <select id="selectCollectedGoodIdsByUserId" resultType="java.lang.Long">
        SELECT goodID
        FROM goods_collection
        WHERE userID = #{userId}
        ORDER BY createTime DESC
    </select>

</mapper>
