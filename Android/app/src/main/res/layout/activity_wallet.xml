<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="25dp"
    android:background="@android:color/white">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_back"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="5pt"
        android:clickable="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@drawable/menu_blue_rounded"
        android:layout_margin="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Balance"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="@font/ubuntu_m"/>

        <TextView
            android:id="@+id/tv_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="¥ 0.00"
            android:textColor="@android:color/white"
            android:textSize="36sp"
            android:fontFamily="@font/ubuntu_b"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_withdraw"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Withdraw"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_pink_rounded"
            android:fontFamily="@font/ubuntu_m"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_flows"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Flows"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_blue_rounded"
            android:fontFamily="@font/ubuntu_m"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_withdraw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Amount"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:background="@drawable/rounded_edittext_bg"/>

        <EditText
            android:id="@+id/et_account"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:hint="Alipay account"
            android:paddingHorizontal="12dp"
            android:background="@drawable/rounded_edittext_bg"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm_withdraw"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_pink_rounded"
            android:fontFamily="@font/ubuntu_m"/>
    </LinearLayout>
</LinearLayout>
